# Copiar a backend/.env (NO subir .env a git)

# Base local (docker compose de la raiz). Usar el puerto de POSTGRES_PORT del .env de la raiz.
# Nube: la cadena del Session pooler de Supabase (la entrega Diego por mensaje directo).
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/ple_sunat

# Puerto de la API (por defecto 3001)
PORT=3001

# Solo si la nube exige SSL y falla sin el: DB_SSL=true
DB_SSL=false
